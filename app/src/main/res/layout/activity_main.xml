<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/farmTabButton"
            android:text="🌾 Farm Res Builder"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/capacityTabButton"
            android:text="📊 Capacity"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/dbTabButton"
            android:text="🗄 Database"
            android:backgroundTint="#455A64"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/logTabButton"
            android:text="📋 Log"
            android:backgroundTint="#6A1B9A"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/farmTab"
        android:fillViewport="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="TRAVIAN FARM ASSISTANT"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <EditText
                        android:id="@+id/server"
                        android:hint="Server URL"
                        android:inputType="textUri"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <EditText
                        android:id="@+id/username"
                        android:hint="Username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <EditText
                        android:id="@+id/password"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <Button
                        android:id="@+id/loginTravian"
                        android:text="🔐 LOGIN"
                        android:backgroundTint="#2E7D32"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <Button
                        android:id="@+id/logoutTravian"
                        android:text="🗑 LOGOUT + HAPUS DATABASE"
                        android:backgroundTint="#C62828"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/refreshVillageLinkPreview"
                        android:text="REFRESH VILLAGE LINK: -"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/resourceBuilderVillageLinkPreview"
                        android:text="RES BUILDER LINK: -"
                        android:textSize="11sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/farmListStatus"
                        android:text="Belum login"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="Range interval acak (menit)"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <EditText
                            android:id="@+id/intervalMin"
                            android:hint="Minimum"
                            android:inputType="number"
                            android:singleLine="true"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"/>
                        <EditText
                            android:id="@+id/intervalMax"
                            android:hint="Maksimum"
                            android:inputType="number"
                            android:singleLine="true"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <CheckBox
                        android:id="@+id/farmListEnabled"
                        android:text="JALANKAN FARM LIST"
                        android:checked="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <CheckBox
                        android:id="@+id/resourceBuilder"
                        android:text="RESOURCE BUILDER — field terendah sampai level 20"
                        android:checked="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <CheckBox
                        android:id="@+id/townBuilder"
                        android:text="TOWN BUILDER"
                        android:checked="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <Button
                        android:id="@+id/refreshVillages"
                        android:text="🔄 REFRESH VILLAGE"
                        android:backgroundTint="#1565C0"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="Pilih village untuk Resource Builder / Hold Celebration"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:id="@+id/villageChecklist"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/status"
                        android:text="Status: STOPPED"
                        android:textSize="17sp"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/lastRun"
                        android:text="Last run: --"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/farmCycleTime"
                        android:text="Waktu Siklus Farm List: 00:00:00"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/resourceCycleTime"
                        android:text="Waktu Siklus Resource Builder: 00:00:00"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/townCycleTime"
                        android:text="Waktu Siklus Town Builder: 00:00:00"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/holdCelebrationCycleTime"
                        android:text="Waktu Siklus Hold Celebration: 00:00:00"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/nextRun"
                        android:text="Next run: -- | Countdown: --:--:--"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <Switch
                        android:id="@+id/botToggle"
                        android:text="BOT MATI"
                        android:backgroundTint="#D32F2F"
                        android:textOn="BOT AKTIF"
                        android:textOff="BOT MATI"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:showText="true"
                        android:minHeight="68dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="68dp"/>
                </LinearLayout>
            <LinearLayout
                android:id="@+id/recentLogsBox"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="#202020"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="5 LOG TERAKHIR"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/recentLogs"
                    android:textIsSelectable="true"
                    android:text="Belum ada log."
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:maxLines="5"
                    android:ellipsize="end"
                    android:layout_marginTop="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <!--
                No Live Bot UI.
                The WebView below is retained only as an invisible compatibility
                surface for legacy login/DOM helper code. All actual automation
                runs on FarmAutomationService's private WebView.
            -->
            <WebView
                android:id="@+id/webView"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                android:importantForAccessibility="no"
                android:alpha="0"/>
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/capacityTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="CAPACITY OVERVIEW"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/capacityStatus"
                android:text="Belum ada data resource."
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:id="@+id/capacityOverview"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/dbTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="DATABASE VILLAGE"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/villageDatabaseView"
                android:text="DATABASE VILLAGE: kosong"
                android:textSize="10sp"
                android:typeface="monospace"
                android:textIsSelectable="true"
                android:padding="6dp"
                android:layout_marginTop="6dp"
                android:background="#202020"
                android:textColor="#FFFFFF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/logTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="LOG AKTIVITAS (12 JAM TERAKHIR)"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/logOverview"
                android:textIsSelectable="true"
                android:text="Belum ada log."
                android:textSize="12sp"
                android:typeface="monospace"
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
