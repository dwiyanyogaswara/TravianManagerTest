<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/farmTabButton"
            android:text="Farm Res Builder"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/capacityTabButton"
            android:text="Capacity Overview"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/logTabButton"
            android:text="Log"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/farmTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.48"
                android:fillViewport="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="TRAVIAN FARM ASSISTANT"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <EditText
                        android:id="@+id/server"
                        android:hint="Server URL"
                        android:inputType="textUri"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <EditText
                        android:id="@+id/username"
                        android:hint="Username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <EditText
                        android:id="@+id/password"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <Button
                        android:id="@+id/loginTravian"
                        android:text="LOGIN"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/refreshVillageLinkPreview"
                        android:text="REFRESH VILLAGE LINK: -"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/resourceBuilderVillageLinkPreview"
                        android:text="RES BUILDER LINK: -"
                        android:textSize="11sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/farmListStatus"
                        android:text="Belum login"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="Range interval acak (menit)"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <EditText
                            android:id="@+id/intervalMin"
                            android:hint="Minimum"
                            android:inputType="number"
                            android:singleLine="true"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"/>
                        <EditText
                            android:id="@+id/intervalMax"
                            android:hint="Maksimum"
                            android:inputType="number"
                            android:singleLine="true"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <CheckBox
                        android:id="@+id/farmListEnabled"
                        android:text="JALANKAN FARM LIST"
                        android:checked="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <CheckBox
                        android:id="@+id/resourceBuilder"
                        android:text="RESOURCE BUILDER — field terendah sampai level 10"
                        android:checked="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <Button
                        android:id="@+id/refreshVillages"
                        android:text="↻  REFRESH VILLAGE"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="Pilih village untuk Resource Builder"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:id="@+id/villageChecklist"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/status"
                        android:text="Status: STOPPED"
                        android:textSize="17sp"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/lastRun"
                        android:text="Last run: --"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/farmCycleTime"
                        android:text="Waktu Siklus Farm List: 00:00:00"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/resourceCycleTime"
                        android:text="Waktu Siklus Resource Builder: 00:00:00"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/nextRun"
                        android:text="Next run: -- | Countdown: --:--:--"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <Switch
                        android:id="@+id/botToggle"
                        android:text="BOT MATI"
                        android:textOn="BOT AKTIF"
                        android:textOff="BOT MATI"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:showText="true"
                        android:minHeight="68dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="68dp"/>
                </LinearLayout>
            </ScrollView>
            <LinearLayout
                android:id="@+id/recentLogsBox"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="#202020"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="5 LOG TERAKHIR"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/recentLogs"
                    android:textIsSelectable="true"
                    android:text="Belum ada log."
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:maxLines="5"
                    android:ellipsize="end"
                    android:layout_marginTop="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView
                android:id="@+id/liveWebViewLabel"
                android:text="LIVE — HALAMAN YANG DIJALANKAN BOT"
                android:textStyle="bold"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="#1E1E1E"
                android:textColor="#90CAF9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.52"
                android:background="#121212"
                android:overScrollMode="always"
                android:nestedScrollingEnabled="false"
                android:scrollbars="vertical"/>
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/capacityTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="CAPACITY OVERVIEW"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/capacityStatus"
                android:text="Belum ada data resource."
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:id="@+id/capacityOverview"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/logTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="LOG AKTIVITAS (12 JAM TERAKHIR)"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/logOverview"
                android:textIsSelectable="true"
                android:text="Belum ada log."
                android:textSize="12sp"
                android:typeface="monospace"
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
